<p><%= link_to "Back to search", practitioners_path %></p>
<h1><%= @practitioner.full_name %></h1>
<p><%= @practitioner.specialty.humanize %> in <%= @practitioner.city %>. <%= @practitioner.address %></p>
<p><%= @practitioner.bio %></p>
<p>Consultation: <%= number_to_currency(@practitioner.fee, unit: "EUR ", precision: 0) %></p>

<% if notice %><p class="notice"><%= notice %></p><% end %>
<% if alert %><p class="alert"><%= alert %></p><% end %>

<h2>Book</h2>
<%= form_with url: practitioner_appointments_path(@practitioner), method: :post do |f| %>
  <%= f.email_field :email, placeholder: "you@example.com", required: true %>
  <%= f.text_field :first_name, placeholder: "First name" %>
  <%= f.text_field :last_name, placeholder: "Last name" %>
  <%= f.datetime_local_field :starts_at, required: true, value: (Time.current + 1.day).change(min: 0).strftime("%Y-%m-%dT%H:%M") %>
  <%= f.text_field :notes, placeholder: "Reason (optional)" %>
  <%= f.submit "Book appointment" %>
<% end %>

<h2>Next appointments</h2>
<ul>
  <% @upcoming.each do |a| %>
    <li><%= a.starts_at.strftime("%a %d %b %H:%M") %>, <%= a.status %></li>
  <% end %>
</ul>
